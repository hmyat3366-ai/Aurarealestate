# AURA Real Estate — Environment Variables Example
# Duplicate this file as .env.local and fill in your keys.

# Resend API Key for Passwordless Email OTP & Viewing Notifications
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address
# On free/trial Resend accounts without a custom domain, use:
# RESEND_FROM_EMAIL=AURA Real Estate <onboarding@resend.dev>
# On accounts with a verified domain (resend.com/domains), use your domain:
# RESEND_FROM_EMAIL=AURA Real Estate <concierge@yourdomain.com>
RESEND_FROM_EMAIL=AURA Real Estate <onboarding@resend.dev>
